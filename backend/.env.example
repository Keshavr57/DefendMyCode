# TEMPLATE of the settings this app needs. This file IS committed to Git,
# so it must never contain a real key.
#
# To use it: copy this file to a new file called .env, then fill in your values.
# The .env file is NOT committed (see .gitignore).

# Your secret Groq API key. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Which LLM answers our prompts. (llama-3.3-70b-versatile was shut down on Groq's free tier in Aug 2026.)
LLM_MODEL=openai/gpt-oss-120b

# Which speech-to-text model we use (not used until Phase 8).
WHISPER_MODEL=whisper-large-v3-turbo

# Where the SQLite database file lives. "./" means the folder you run the server from.
DATABASE_URL=sqlite:///./repoviva.db

# How much detail to log: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
