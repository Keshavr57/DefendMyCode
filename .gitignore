# .gitignore tells Git which files to NEVER track.
# A "/" at the end means "this is a folder". A "*" means "anything".

# Secrets: our real API key lives here, so it must never reach GitHub.
.env

# Python virtual environment: thousands of installed files. Anyone can
# rebuild it from requirements.txt, so there is no reason to commit it.
venv/

# Python's auto-generated bytecode cache. Python recreates it on its own.
__pycache__/
*.pyc

# SQLite database files: local data, not source code.
*.db

# Vector database folder (used from Phase 3).
chroma_data/

# Temporary cloned repos (used from Phase 2).
repos_tmp/

# Frontend dependencies and build output (used from Phase 7).
node_modules/
dist/
